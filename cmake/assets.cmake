function(generate_assets assets_folder assets_header)
    file(GLOB_RECURSE asset_files CONFIGURE_DEPENDS LIST_DIRECTORIES false "${assets_folder}/*")
    get_filename_component(header_folder "${assets_header}" DIRECTORY)

    set(header [=[#pragma once

// Generated by cmake/assets.cmake.

#include <cstdint>
#include <span>
#include <string_view>

#pragma clang diagnostic push
#pragma clang diagnostic ignored "-Wc++11-narrowing"
#pragma clang diagnostic ignored "-Wc23-extensions"

namespace Assets {
    namespace raw {
]=])
    set(views "")
    set(identifiers "")
    foreach(asset_file IN LISTS asset_files)
        file(RELATIVE_PATH asset_path "${assets_folder}" "${asset_file}")
        string(MAKE_C_IDENTIFIER "${asset_path}" identifier)
        if(identifier IN_LIST identifiers)
            message(FATAL_ERROR "Duplicate asset identifier: ${identifier}")
        endif()
        list(APPEND identifiers "${identifier}")

        file(RELATIVE_PATH embed_path "${header_folder}" "${asset_file}")
        string(APPEND header "        inline constexpr uint8_t ${identifier}[] = {\n            #embed \"${embed_path}\" suffix(, 0) if_empty(0)\n        };\n")

        get_filename_component(extension "${asset_file}" LAST_EXT)
        if(extension STREQUAL ".bsml")
            string(APPEND views "    inline const std::string_view ${identifier}{reinterpret_cast<const char*>(raw::${identifier}), sizeof(raw::${identifier}) - 1};\n")
        else()
            string(APPEND views "    inline constexpr std::span<const uint8_t> ${identifier}{raw::${identifier}, sizeof(raw::${identifier}) - 1};\n")
        endif()
    endforeach()
    string(APPEND header "    }\n\n#pragma clang diagnostic pop\n\n${views}}\n")

    if(EXISTS "${assets_header}")
        file(READ "${assets_header}" current_header)
    endif()
    if(NOT header STREQUAL current_header)
        file(WRITE "${assets_header}" "${header}")
    endif()
endfunction()
